# Copier ce fichier en .env.local et choisir UN backend IA.
# Sans variable → le jeu fonctionne normalement, sans IA narrative.

# ── Option 1 : Ollama (auto-hébergé, gratuit, aucun compte requis) ────────────
# Installer Ollama : https://ollama.ai  puis : ollama pull llama3.2
# Si Ollama tourne sur ton Proxmox :  VITE_OLLAMA_URL=http://192.168.x.x:11434
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.2

# ── Option 2 : Groq (cloud, gratuit, compte requis sur console.groq.com) ──────
# Créer un compte → API Keys → créer une clé (tier gratuit suffisant)
# VITE_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxx

# ── Option 3 : Endpoint OpenAI-compatible custom (n8n, LM Studio, etc.) ───────
# VITE_AI_ENDPOINT=https://mon-serveur/v1/chat/completions
# VITE_AI_KEY=optionnel
# VITE_AI_MODEL=nom-du-modele
